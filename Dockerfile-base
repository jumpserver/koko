FROM debian:trixie-slim AS stage-ffmpeg
ARG APT_MIRROR=http://deb.debian.org
RUN set -ex \
    && sed -i "s@http://.*.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential pkg-config nasm libx264-dev xz-utils ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Debian mirrors the byte-identical upstream archive on its CDN.
RUN set -ex \
    && for url in \
        https://deb.debian.org/debian/pool/main/f/ffmpeg/ffmpeg_7.1.5.orig.tar.xz \
        https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz; do \
        if curl --fail --location --retry 5 --retry-all-errors \
            --connect-timeout 30 --max-time 180 --retry-max-time 600 \
            --output /tmp/ffmpeg.tar.xz "${url}" \
            && echo 'de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f  /tmp/ffmpeg.tar.xz' \
                | sha256sum -c -; then \
            exit 0; \
        fi; \
    done \
    && exit 1

# Web recordings only need JPEG frames, scaling, H.264 encoding and MP4 output.
# FFmpeg libraries are static; libx264, libc and libm remain dynamic.
RUN set -ex \
    && mkdir /tmp/ffmpeg \
    && tar -xf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg --strip-components=1 \
    && cd /tmp/ffmpeg \
    && ./configure --disable-everything --disable-autodetect --disable-network \
        --disable-doc --disable-debug --disable-ffplay --disable-ffprobe \
        --disable-avdevice --disable-swresample --disable-shared --enable-static \
        --enable-small --enable-ffmpeg --enable-gpl --enable-libx264 \
        --enable-protocol=file --enable-demuxer=concat,image2 \
        --enable-parser=mjpeg --enable-decoder=mjpeg --enable-encoder=libx264 \
        --enable-muxer=mp4 --enable-filter=scale,format,null --enable-swscale \
    && make -j2 ffmpeg \
    && install -m 755 ffmpeg /usr/local/bin/ffmpeg \
    && strip /usr/local/bin/ffmpeg

FROM ghcr.io/jumpserver-dev/libghostty-vt:ghostty-d4ac93a0395d-zig-0.15.2-build-3.1 AS libghostty-vt

# Keep the Go version aligned with go.mod.
FROM golang:1.26.10-trixie
ARG TARGETARCH

WORKDIR /opt

ARG USQL_VERSION=v0.2.9

ARG K8S_BUNDLE_VERSION=v0.0.1

RUN set -ex \
    && mkdir -p /opt/koko/bin \
    && wget https://github.com/jumpserver-dev/k8s-bundle/releases/download/${K8S_BUNDLE_VERSION}/k8s-bundle_${TARGETARCH}.deb \
    && dpkg -i k8s-bundle_${TARGETARCH}.deb \
    && cp /usr/local/bin/kubectl /opt/koko/bin/kubectl \
    && cp /usr/local/bin/helm /opt/koko/bin/helm \
    && wget https://github.com/jumpserver-dev/healthcheck/releases/latest/download/check_linux_${TARGETARCH}.deb \
    && dpkg -i check_linux_${TARGETARCH}.deb \
    && cp /usr/local/bin/check /opt/koko/bin/ \
    && rm -f check_linux_${TARGETARCH}.deb \
    && wget https://github.com/jumpserver-dev/usql/releases/download/${USQL_VERSION}/usql-${USQL_VERSION}-linux-${TARGETARCH}.tar.gz \
    && tar -xf usql-${USQL_VERSION}-linux-${TARGETARCH}.tar.gz -C /opt/koko/bin/ \
    && /opt/koko/bin/usql --drivers | grep -qx mongodb \
    && /opt/koko/bin/usql --drivers | grep -qx redis \
    && wget -O /opt/koko/.kubectl_aliases https://github.com/ahmetb/kubectl-aliases/raw/master/.kubectl_aliases \
    && chmod 755 /opt/koko/bin/* \
    && chown root:root /opt/koko/bin/* \
    && rm -f *.tar.gz *.tar.bz2

ARG S6_OVERLAY_VERSION=3.2.2.0
RUN set -ex \
    && case "${TARGETARCH}" in \
        amd64) s6_arch="x86_64" ;; \
        arm64) s6_arch="aarch64" ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && mkdir -p /opt/s6-overlay \
    && wget -O /opt/s6-overlay/s6-overlay-noarch.tar.xz "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" \
    && wget -O /opt/s6-overlay/s6-overlay-arch.tar.xz "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${s6_arch}.tar.xz"

WORKDIR /opt/koko

COPY --from=libghostty-vt /opt/libghostty-vt /opt/libghostty-vt
COPY --from=stage-ffmpeg /usr/local/bin/ffmpeg /opt/koko/bin/ffmpeg

RUN set -ex \
    && apt-get update \
    && apt-get install -y --no-install-recommends pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/koko/

ENV CGO_ENABLED=1
ENV PKG_CONFIG_PATH=/opt/libghostty-vt/share/pkgconfig
ENV GO111MODULE=on

COPY go.mod go.sum ./

RUN go mod download -x
